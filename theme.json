{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#0057B8", "name": "Primary" },
        { "slug": "secondary", "color": "#FFD700", "name": "Secondary" },
        { "slug": "background", "color": "#FFFFFF", "name": "Background" },
        { "slug": "foreground", "color": "#222222", "name": "Foreground" }
      ],
      "custom": true,
      "customGradient": true
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "Inter, sans-serif", "slug": "inter", "name": "Inter" },
        { "fontFamily": "Georgia, serif", "slug": "georgia", "name": "Georgia" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "14px", "name": "Small" },
        { "slug": "medium", "size": "18px", "name": "Medium" },
        { "slug": "large", "size": "32px", "name": "Large" }
      ],
      "customFontSize": true,
      "customLineHeight": true
    },
    "spacing": {
      "customPadding": true,
      "customMargin": true,
      "units": [ "px", "em", "rem", "%" ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#222222"
    },
    "typography": {
      "fontFamily": "Inter, sans-serif",
      "fontSize": "18px",
      "lineHeight": "1.6"
    }
  },
  "customTemplates": [
    {
      "name": "full-width",
      "title": "Full Width",
      "postTypes": [ "page", "post" ]
    }
  ]
}