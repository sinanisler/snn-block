{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "snn/simple-gallery",
    "version": "1.0.0",
    "title": "Simple Gallery",
    "category": "media",
    "icon": "images-alt2",
    "description": "Responsive image gallery with full custom styling — columns, gaps, borders, shadows, and lightbox.",
    "keywords": ["gallery", "images", "photos", "grid"],
    "attributes": {
        "images": {
            "type": "array",
            "default": [],
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "number" },
                    "url": { "type": "string" },
                    "alt": { "type": "string" },
                    "caption": { "type": "string" }
                }
            }
        },
        "columns": { "type": "object", "default": {} },
        "gap": { "type": "object", "default": {} },
        "aspectRatio": { "type": "object", "default": {} },
        "enableLightbox": { "type": "boolean", "default": false },
        "bgColor": { "type": "object", "default": {} },
        "padding": { "type": "object", "default": {} },
        "margin": { "type": "object", "default": {} },
        "border": { "type": "object", "default": {} },
        "borderRadius": { "type": "object", "default": {} },
        "boxShadow": { "type": "object", "default": {} },
        "customCSS": { "type": "string", "default": "" }
    },
    "supports": {
        "html": false,
        "anchor": true,
        "align": ["wide", "full", "center"]
    },
    "style": "file:./block.css",
    "render": "file:./block.php"
}
