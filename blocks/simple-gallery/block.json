{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "snn/simple-gallery",
    "version": "1.0.0",
    "title": "Simple Gallery",
    "category": "media",
    "icon": "images-alt2",
    "description": "A responsive image gallery block with multi-image selection and configurable columns.",
    "keywords": ["gallery", "images", "photos", "grid"],
    "attributes": {
        "images": {
            "type": "array",
            "default": [],
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "number" },
                    "url": { "type": "string" },
                    "alt": { "type": "string" },
                    "caption": { "type": "string" }
                }
            }
        },
        "columns": {
            "type": "object",
            "default": {}
        },
        "gap": {
            "type": "object",
            "default": {}
        },
        "aspectRatio": {
            "type": "object",
            "default": {}
        },
        "enableLightbox": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full", "center"],
        "anchor": true,
        "spacing": {
            "margin": true,
            "padding": true
        },
        "color": {
            "background": true,
            "text": false
        },
        "borders": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    },
    "style": "file:./block.css"
}
