{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "snn/text",
    "version": "1.0.0",
    "title": "Text",
    "category": "text",
    "icon": "text",
    "description": "",
    "keywords": ["text", "paragraph", "heading", "typography"],
    "attributes": {
        "content": { "type": "string", "default": "" },
        "tagName": { "type": "string", "default": "p" },
        "textColor": { "type": "object", "default": {} },
        "bgColor": { "type": "object", "default": {} },
        "fontSize": { "type": "object", "default": {} },
        "fontWeight": { "type": "object", "default": {} },
        "textTransform": { "type": "string" },
        "textAlign": { "type": "object", "default": {} },
        "padding": { "type": "object", "default": {} },
        "customCSS": { "type": "string", "default": "" }
    },
    "supports": {
        "html": false,
        "anchor": true
    },
    "style": "file:./block.css",
    "render": "file:./block.php"
}
